# Application Configuration
APP_NAME=MixSense
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# Database Configuration (SQLite default for local, or PostgreSQL)
DATABASE_URL=sqlite:///mixsense.db
# DATABASE_URL=postgresql://mixsense_user:mixsense_secret@localhost:5432/mixsense_db
ENABLE_HISTORY_STORAGE=True

# PostgreSQL Container Credentials (for Docker Compose)
POSTGRES_USER=mixsense_user
POSTGRES_PASSWORD=mixsense_secret
POSTGRES_DB=mixsense_db

# Model Parameters
TRANSFORMER_MODEL_NAME=xlm-roberta-base
USE_GPU=False
